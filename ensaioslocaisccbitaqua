            { id: 36, setor: "4", cidade: "Itaquaquecetuba", bairro: "Vila Japão", ensaio: "1° D - 16h" },
            { id: 37, setor: "4", cidade: "Itaquaquecetuba", bairro: "Vila Nely", ensaio: "1° S - 17h" },
            { id: 38, setor: "4", cidade: "Itaquaquecetuba", bairro: "Vila São Carlos", ensaio: "1° S - 17h" },
            { id: 39, setor: "3", cidade: "Itaquaquecetuba", bairro: "Cidade Nova Louzada", ensaio: "4° D - 16h" },
            { id: 40, setor: "3", cidade: "Itaquaquecetuba", bairro: "Estancia Guatambú", ensaio: "1° D - 16h" },
            { id: 41, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Adriane", ensaio: "U° S - 17h" },
            { id: 42, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Caiuby", ensaio: "1° S - 17h" },
            { id: 43, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Canaã", ensaio: "Ú° D - 16h" },
            { id: 44, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Carolina", ensaio: "1° D - 16h" },
            { id: 45, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Josely", ensaio: "1° D - 16h" },
            { id: 46, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Monica", ensaio: "4° D - 16h" },
            { id: 47, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Patricia", ensaio: "1° D - 16h" },
            { id: 48, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Pinheirinho", ensaio: "3° S - 17h" },
            { id: 49, setor: "3", cidade: "Itaquaquecetuba", bairro: "Jardim Silvestre", ensaio: "3° S - 16:30h" },
            { id: 50, setor: "3", cidade: "Itaquaquecetuba", bairro: "Parque Village", ensaio: "Ú° S - 17h" }
        ];

        const container = document.getElementById('cards-container');
        const searchInput = document.getElementById('search-input');
        const filterSetor = document.getElementById('filter-setor');
        const filterDia = document.getElementById('filter-dia');
        const filterHora = document.getElementById('filter-hora');
        const noResults = document.getElementById('no-results');
        const totalCount = document.getElementById('total-count');

        function renderCards(data) {
            container.innerHTML = '';
            totalCount.textContent = data.length;
            
            if(data.length === 0) {
                noResults.classList.remove('hidden');
                return;
            }
            noResults.classList.add('hidden');

            data.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-2xl p-4 shadow-xs border border-slate-100 hover:border-slate-300 active:scale-[0.99] transition-all flex items-center justify-between gap-3 cursor-pointer";
                card.onclick = () => openModal(item);
                
                card.innerHTML = `
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="bg-slate-100 text-slate-800 text-[10px] font-bold px-2.5 py-0.5 rounded-full border border-slate-200">Setor ${item.setor}</span>
                            <span class="text-xs text-slate-400 truncate"><i class="fa-solid fa-church text-[10px] mr-1"></i> CCB</span>
                        </div>
                        <h4 class="text-sm font-bold text-slate-900 truncate">${item.bairro}</h4>
                        <div class="mt-1.5 text-xs text-amber-800 font-semibold flex items-center gap-1.5">
                            <i class="fa-regular fa-clock text-[11px] text-amber-600"></i>
                            <span>${item.ensaio}</span>
                        </div>
                    </div>
                    <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 shrink-0 border border-slate-100">
                        <i class="fa-solid fa-chevron-right text-xs"></i>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function filterData() {
            const searchTerm = searchInput.value.toLowerCase();
            const setorVal = filterSetor.value;
            const diaVal = filterDia.value;
            const horaVal = filterHora.value;

            const filtered = agendaData.filter(item => {
                const matchSearch = item.bairro.toLowerCase().includes(searchTerm);
                const matchSetor = setorVal === "" || item.setor === setorVal;
                const matchDia = diaVal === "" || item.ensaio.toUpperCase().includes(diaVal.toUpperCase());
                const matchHora = horaVal === "" || item.ensaio.toLowerCase().includes(horaVal.toLowerCase());
                
                return matchSearch && matchSetor && matchDia && matchHora;
            });

            renderCards(filtered);
        }

        function resetFilters() {
            searchInput.value = '';
            filterSetor.value = '';
            filterDia.value = '';
            filterHora.value = '';
            renderCards(agendaData);
        }

        searchInput.addEventListener('input', filterData);
        filterSetor.addEventListener('change', filterData);
        filterDia.addEventListener('change', filterData);
        filterHora.addEventListener('change', filterData);

        // Modal Controls
        const modal = document.getElementById('detail-modal');
        const modalContainer = document.getElementById('modal-container');

        function openModal(item) {
            document.getElementById('modal-setor').textContent = `Setor ${item.setor}`;
            document.getElementById('modal-bairro').textContent = item.bairro;
            document.getElementById('modal-cidade').textContent = `${item.cidade} - SP`;
            document.getElementById('modal-ensaio').textContent = item.ensaio;
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContainer.classList.remove('translate-y-full', 'sm:scale-95');
                modalContainer.classList.add('translate-y-0', 'sm:scale-100');
            }, 10);
        }

        function closeModal() {
            modal.classList.add('opacity-0');
            modalContainer.classList.remove('translate-y-0', 'sm:scale-100');
            modalContainer.classList.add('translate-y-full', 'sm:scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        modal.addEventListener('click', (e) => {
            if(e.target === modal) closeModal();
        });

        // Inicializar com todas as 50 congregações
        renderCards(agendaData);
    </script>
</body>
</html>
